# ==========================================
# AI Job Agent - Environment Configuration
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_job_agent
POSTGRES_PORT=5432

# Database Connection URL
# For host-based development (connecting from your workstation to PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_job_agent?schema=public
# For Docker internal container networking:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_job_agent?schema=public

# File Storage Configuration
# For host development: storage/resumes (relative to apps/api)
UPLOAD_DIR=storage/resumes
# For Docker container: /app/storage/resumes
MAX_RESUME_SIZE_MB=10

# API Service Configuration
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Frontend Web Configuration
VITE_API_URL=http://localhost:3000

# Ollama AI Configuration (Milestone 5)
# When running API inside Docker, Ollama on host is reached via host.docker.internal:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# When running API directly on host machine, use 127.0.0.1:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=120000
MAX_AI_RESUME_CHARS=30000

# Browser Automation (Milestone 10.1)
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_MAX_CONTEXTS=1
BROWSER_SCREENSHOT_DIR=storage/browser/screenshots
