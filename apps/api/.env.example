# Port the Fastify API listens on
PORT=3000

# Host interface to bind to (0.0.0.0 is required for Docker/container readiness)
HOST=0.0.0.0

# Allowed CORS origin for web client
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Connection String
# Use localhost when running API directly on host machine:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_job_agent?schema=public
# Use postgres service name when running inside Docker Compose:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_job_agent?schema=public

# Resume File Storage
UPLOAD_DIR=storage/resumes
MAX_RESUME_SIZE_MB=10

# Ollama AI Configuration
# In Docker: http://host.docker.internal:11434 | On Host: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=120000
MAX_AI_RESUME_CHARS=30000

# Browser Automation (Milestone 10.1)
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_MAX_CONTEXTS=1
BROWSER_SCREENSHOT_DIR=storage/browser/screenshots
